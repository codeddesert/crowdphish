# Copy to .env before starting the stack. Do not commit .env.

POSTGRES_DB=crowdphish
POSTGRES_USER=crowdphish
POSTGRES_PASSWORD=

DATABASE_URL=postgres://crowdphish:@crowdphish_db:5432/crowdphish
SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=crowdphish.washk12.org,phishing.washk12.org,localhost,crowdphish
CSRF_TRUSTED_ORIGINS=https://crowdphish.washk12.org,https://phishing.washk12.org
TIME_ZONE=America/Denver

DJANGO_SUPERUSER_USERNAME=analyst
DJANGO_SUPERUSER_EMAIL=analyst@washk12.org
DJANGO_SUPERUSER_PASSWORD=

PHISHING_API_TOKEN=
PHISHING_API_CLIENT_NAME=gmail-addon

PHISHING_GMAIL_SERVICE_ACCOUNT_FILE=/opt/secrets/phishing-gmail.json
PHISHING_GMAIL_GROUP_INGEST_MAILBOX=watchtowerapi@washk12.org
PHISHING_GMAIL_GROUP_FORWARD_ADDRESS=phishing@washk12.org
PHISHING_DELEGATION_ALLOWED_DOMAINS=washk12.org
PHISHING_TRUSTED_DOMAINS=washk12.org

IPQUALITYSCORE_API_KEY=
VIRUSTOTAL_API_KEY=
APIFLASH_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
